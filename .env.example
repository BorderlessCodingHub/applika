# Environment for the root docker-compose.yml (the local stack).
#
#   cp .env.example .env
#
# Commented lines show the default the stack uses when the key is unset.
# Never commit a real secret: `.env` is git-ignored, this file is not.
#
# Generate a Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"


# =============================================================================
# Borderless sign-in (required)
# =============================================================================
# applika is a confidential OpenID Connect client of Borderless (ADR-0026).
# The API boots without these, but every sign-in lands on
# /login?error=AUTH-1018 until all four are set.
#
# For local runs without a real Borderless client, use the fake. Its synthetic
# client id and secret are in backend/tests/fixtures/borderless/accounts.json:
#   cd backend && uv run python tests/fixtures/borderless/fake_oidc.py \
#     --port 8081 --issuer http://127.0.0.1:8081/api/auth

BORDERLESS_ISSUER=
BORDERLESS_CLIENT_ID=
BORDERLESS_CLIENT_SECRET=
# Fernet key: encrypts the Borderless refresh token (Postgres) and access token (Redis)
BORDERLESS_TOKEN_ENCRYPTION_KEY=


# =============================================================================
# Public URLs
# =============================================================================
# Where the browser reaches the web app and the API. The defaults are the local
# stack (web on :8080, api on :8000). Behind a tunnel or a custom domain, change
# ALL of them together: the web, the API and Borderless must agree, or the
# sign-in fails with AUTH-1046 or the browser blocks the API calls (CORS).
#
#   Example, web on https://app.example.com and api on https://api.example.com:
#     API_BASE_URL=https://api.example.com/api
#     CORS_ORIGINS='["https://app.example.com"]'
#     WEB_SIGNIN_URI=https://app.example.com/login
#     BORDERLESS_REDIRECT_URI=https://api.example.com/api/auth/borderless/callback
#     ACCOUNT_LINK_REDIRECT_URI=https://app.example.com/profile
#     GITHUB_REDIRECT_URI=https://api.example.com/api/auth/github/callback
#   Keep the web and the api on the same site (one parent domain): the session
#   cookies are SameSite=Lax.

# The API base URL the web calls. Baked into the static export at BUILD time:
# after changing it, rebuild with `docker compose up -d --build web`.
# API_BASE_URL=http://127.0.0.1:8000/api

# The web origins allowed to call the API, a JSON array (quote it).
# Recreate the api after changing it: `docker compose up -d api`.
# CORS_ORIGINS='["http://127.0.0.1:8080"]'

# The web sign-in page. Every Borderless sign-in ends here (?error=<code> on refusal).
# WEB_SIGNIN_URI=http://127.0.0.1:8080/login

# Borderless's callback on the API. Must equal a redirect URI registered at
# Borderless exactly (https in production).
# BORDERLESS_REDIRECT_URI=http://127.0.0.1:8000/api/auth/borderless/callback

# The profile page the GitHub restore returns to.
# ACCOUNT_LINK_REDIRECT_URI=http://127.0.0.1:8080/profile


# =============================================================================
# Sessions
# =============================================================================
# Signs the session JWTs. Any string works locally; use a long random one elsewhere.
# JWT_SECRET=dev-jwt-secret-not-for-production


# =============================================================================
# GitHub restore (optional)
# =============================================================================
# The one-shot "Restore your data from GitHub" for accounts from the GitHub
# sign-in era (ADR-0024). GitHub is not a sign-in. Without the id and secret,
# POST /auth/github/restore answers 503.
#
# Create an OAuth app at https://github.com/settings/developers with the
# Authorization callback URL set to GITHUB_REDIRECT_URI.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/auth/github/callback


# =============================================================================
# Discord (optional)
# =============================================================================
# Webhook that receives in-app user feedback. Off when empty. Report webhooks
# are configured in the admin area (/admin/report-webhooks), not here.
# DISCORD_FEEDBACK_WEBHOOK=
