# Copy to `.env` and fill in: cp .env.example .env
# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ---- Required ----------------------------------------------------------------
# GitHub OAuth app (https://github.com/settings/developers)
#   Callback URL: http://127.0.0.1:8000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Fernet key
GITHUB_TOKEN_ENCRYPTION_KEY=

# ---- Optional (defaults shown) -----------------------------------------------
# JWT_SECRET=dev-jwt-secret-not-for-production
# GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/auth/github/callback
# LOGIN_REDIRECT_URI=http://127.0.0.1:8080/dashboard

# Discord feedback posts (off when empty)
# DISCORD_FEEDBACK_WEBHOOK=

# Discord account link (off unless the id, secret and key are all set)
# Discord app (https://discord.com/developers/applications -> OAuth2)
#   Redirect: http://127.0.0.1:8000/api/auth/link/discord/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Fernet key, different from the GitHub one
# DISCORD_TOKEN_ENCRYPTION_KEY=
# DISCORD_LINK_REDIRECT_URI=http://127.0.0.1:8000/api/auth/link/discord/callback
# ACCOUNT_LINK_REDIRECT_URI=http://127.0.0.1:8080/profile
