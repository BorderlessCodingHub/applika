# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#   cp .env.example .env
# Consumed by docker-compose.yml (the local dev stack).

# ---- Required: the api will not boot without these -------------------------
# A GitHub OAuth app you own: https://github.com/settings/developers
#   Homepage URL:               http://127.0.0.1:8080
#   Authorization callback URL: http://127.0.0.1:8000/api/auth/github/callback
# GitHub is the sole login (ADR 0002), so without a real app you cannot sign in
# through the UI — see the README for the seeded-session alternative.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must be a valid Fernet key (base64-encoded 32 bytes) — the default in
# settings.py is a placeholder string and will fail at runtime. Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=

# ---- Optional: sensible local defaults are applied if omitted --------------
# JWT_SECRET=dev-jwt-secret-not-for-production
# GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/auth/github/callback
# LOGIN_REDIRECT_URI=http://127.0.0.1:8080/dashboard

# Discord integrations are off unless set.
# DISCORD_REPORTS_WEBHOOK=
# DISCORD_FEEDBACK_WEBHOOK=
# DISCORD_REPORTS_ORGANIZATION=

# Discord account link from the profile (PRD 0009). Connect Discord is off
# (503) unless both are set. A Discord app you own:
#   https://discord.com/developers/applications -> OAuth2
#   Redirect: http://127.0.0.1:8000/api/auth/link/discord/callback
# Only the Discord user id is stored; the app asks for scope `identify` only.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_LINK_REDIRECT_URI=http://127.0.0.1:8000/api/auth/link/discord/callback
# ACCOUNT_LINK_REDIRECT_URI=http://127.0.0.1:8080/profile
