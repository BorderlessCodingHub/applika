# Copy to `.env` and fill in: cp .env.example .env
# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ---- Required ----------------------------------------------------------------
# Sign in with Borderless through OpenID Connect (ADR-0026): applika is a
# confidential client of Borderless. Sign-in answers ?error=AUTH-1018 until the
# issuer, the client id, the secret and the key are all set. Never commit a
# real secret. For local runs, the fake Borderless (its synthetic client id and
# secret are in backend/tests/fixtures/borderless/accounts.json):
#   cd backend && uv run python tests/fixtures/borderless/fake_oidc.py --port 8081 --issuer http://127.0.0.1:8081/api/auth
BORDERLESS_ISSUER=
BORDERLESS_CLIENT_ID=
BORDERLESS_CLIENT_SECRET=
# Fernet key for the Borderless refresh token (Postgres) and access token (Redis)
BORDERLESS_TOKEN_ENCRYPTION_KEY=

# ---- Optional (defaults shown) -----------------------------------------------
# JWT_SECRET=dev-jwt-secret-not-for-production
# WEB_SIGNIN_URI=http://127.0.0.1:8080/login
# Must equal a redirect URI registered at Borderless (production: https)
# BORDERLESS_REDIRECT_URI=http://127.0.0.1:8000/api/auth/borderless/callback
# GitHub restore of old accounts' data (503 until the id and secret are set)
# GitHub OAuth app (https://github.com/settings/developers)
#   Callback URL: http://127.0.0.1:8000/api/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/auth/github/callback
# LOGIN_REDIRECT_URI=http://127.0.0.1:8080/dashboard

# Discord feedback posts (off when empty)
# DISCORD_FEEDBACK_WEBHOOK=

# Where the GitHub restore lands
# ACCOUNT_LINK_REDIRECT_URI=http://127.0.0.1:8080/profile
