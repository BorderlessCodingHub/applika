# Copy to `.env` and fill in: cp .env.example .env
# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ---- Required ----------------------------------------------------------------
# Borderless sign-in (ADR-0024): the API checks the email and password with
# Borderless from the server. For local runs, the stub:
#   python backend/tests/fixtures/borderless/stub.py   (port 8081)
BORDERLESS_API_URL=
# Fernet key for the stored Borderless access token
BORDERLESS_TOKEN_ENCRYPTION_KEY=

# ---- Optional (defaults shown) -----------------------------------------------
# JWT_SECRET=dev-jwt-secret-not-for-production
# WEB_SIGNIN_URI=http://127.0.0.1:8080/login
# GitHub restore of old accounts' data (503 until the id and secret are set)
# GitHub OAuth app (https://github.com/settings/developers)
#   Callback URL: http://127.0.0.1:8000/api/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/auth/github/callback
# LOGIN_REDIRECT_URI=http://127.0.0.1:8080/dashboard

# Discord feedback posts (off when empty)
# DISCORD_FEEDBACK_WEBHOOK=

# Where the GitHub restore lands
# ACCOUNT_LINK_REDIRECT_URI=http://127.0.0.1:8080/profile
